<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="odd or even"/>
        <attribute name="authors" value="vishn"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-01-06 03:13:42 PM"/>
        <attribute name="created" value="dmlzaG47TEFQVE9QLUYyRUgwVURDOzIwMjYtMDEtMDY7MDM6MDk6MzUgUE07Mjg3MQ=="/>
        <attribute name="edited" value="dmlzaG47TEFQVE9QLUYyRUgwVURDOzIwMjYtMDEtMDY7MDM6MTM6NDIgUE07MTsyOTcy"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a" type="Integer" array="False" size=""/>
            <input variable="a"/>
            <if expression="a%2==0">
                <then>
                    <output expression="&quot;even&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;odd&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
